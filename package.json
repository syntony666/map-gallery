{
  "name": "map-gallery",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=@map-gallery/web\" \"npm run dev --workspace=@map-gallery/api\"",
    "dev:web": "npm run dev --workspace=@map-gallery/web",
    "dev:api": "npm run dev --workspace=@map-gallery/api",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "es5-ext": false,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true
  }
}
